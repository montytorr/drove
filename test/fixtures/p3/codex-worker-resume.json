{
  "kind": "codex",
  "role": "worker",
  "cwd": "/work/repo/.claude/worktrees/w-api",
  "env": {
    "DROVE_HOME": "/home/cal/.drove",
    "DROVE_RUN": "drove-20261009-1042-a3f1",
    "DROVE_ROLE": "worker",
    "DROVE_SEAT": "w-api",
    "DROVE_TOKEN": "tok-0123456789abcdef",
    "DROVE_AGENT": "codex"
  },
  "argv": [
    "resume",
    "thread-1",
    "--dangerously-bypass-approvals-and-sandbox",
    "-C",
    "/work/repo/.claude/worktrees/w-api",
    "-c",
    "model_reasoning_effort=\"low\"",
    "-c",
    "check_for_update_on_startup=false",
    "-c",
