    "-c",
    "mcp_servers.drove.command=\"node\"",
    "-c",
    "mcp_servers.drove.args=[\"/opt/drove/src/cli.ts\", \"mcp\"]",
    "-c",
    "mcp_servers.drove.env_vars=[\"DROVE_HOME\", \"DROVE_RUN\", \"DROVE_ROLE\", \"DROVE_SEAT\", \"DROVE_TOKEN\"]",
    "-c",
    "mcp_servers.drove.default_tools_approval_mode=\"approve\"",
    "-c",
    "hooks.PreToolUse=[{matcher=\"Bash|shell|exec_command|apply_patch\", hooks=[{type=\"command\", command=\"node /opt/drove/src/cli.ts guard pre-tool-use\", timeout=10}]}]",
    "-c",
    "hooks.SessionStart=[{hooks=[{type=\"command\", command=\"node /opt/drove/src/cli.ts guard session-start\", timeout=10}]}]",
    "-c",
    "hooks.UserPromptSubmit=[{hooks=[{type=\"command\", command=\"node /opt/drove/src/cli.ts guard user-prompt-submit\", timeout=10}]}]",
    "-c",
    "hooks.Stop=[{hooks=[{type=\"command\", command=\"node /opt/drove/src/cli.ts guard stop\", timeout=10}]}]",
    "-c",
    "hooks.PermissionRequest=[{hooks=[{type=\"command\", command=\"node /opt/drove/src/cli.ts guard permission-request\", timeout=10}]}]",
